+#ifdef USE_WING
+// Tailsitter hover (angle_tailsitter = ON, active in ANGLE mode).
+//
+// Angle mode levels a "hover frame": the body pitched 90 deg nose-up, so the
+// nose-up hover reads as level.  With body axes x = nose, y = left, z = top:
+//     x_h = -z  (the belly side: where the aircraft goes in a transition)
+//     y_h =  y
+//     z_h =  x  (the nose, pointing up in the hover)
+// so hover roll = -body yaw, hover pitch = body pitch, hover yaw = body roll.
+// Only the self-levelling outer loop runs in the hover frame; its rate
+// setpoints are mapped back to body axes, and the body rate PIDs, mixer and
+// servo mixing are untouched.  Pitch the hover frame forward 90 deg and it is
+// forward flight.
+//
+// Sticks keep their aircraft (3D-plane) meaning, as in an acro hover:
+//   pitch stick -> hover pitch angle (elevator)
+//   yaw stick   -> hover roll angle, i.e. the nose leans the way the rudder
+//                  points (differential thrust)
+//   roll stick  -> body roll rate, i.e. spin about the vertical (elevons
+//                  opposed), not levelled
+static bool tailsitterHoverActive(const pidProfile_t *pidProfile)
+{
+    return pidProfile->angle_tailsitter && FLIGHT_MODE(ANGLE_MODE);
+}
+
+// Attitude in the hover frame, decidegrees, same conventions as attitude.raw
+// (roll right positive, pitch nose-down positive).
+static int16_t tailsitterHoverAttitude(int axis)
+{
+    // rMat row 2 is earth-up in body axes; express it in hover axes
+    const float ux = -rMat.m[2][2];
+    const float uy =  rMat.m[2][1];
+    const float uz =  rMat.m[2][0];
+    if (axis == FD_ROLL) {
+        return lrintf(atan2_approx(uy, uz) * (1800.0f / M_PIf));
+    }
+    return lrintf(((0.5f * M_PIf) - acos_approx(-ux)) * (1800.0f / M_PIf));
+}
